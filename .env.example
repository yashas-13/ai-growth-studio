# AI Growth Studio environment
# Copy this file to .env and set values in your local secret store.
# Do not commit .env or send connection strings through chat.

# PostgreSQL connection string used by Prisma CLI and the server.
# Example format only; replace with your actual provider details.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Add after choosing an authentication provider.
# AUTH_SECRET="replace-with-32-byte-random-secret"

# Add when the background job architecture is selected.
# REDIS_URL="redis://localhost:6379"

# Keep AI credentials server-side only. Never use NEXT_PUBLIC_ prefixes.
# AI_PROVIDER="openai"
# AI_API_KEY="set-in-your-secret-manager"
