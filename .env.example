# AI Growth Studio environment
# Keep .env out of source control. Never put Supabase secret/service-role keys in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional server-side AI integration credentials (never NEXT_PUBLIC_).
# OPENAI_API_KEY=
